    },
    "This app displays your step and weight data in interactive charts.\n\nYou can also add new step or weight data to Apple Health from this app. Your data is private and secured." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja pokazuje Twoje dane o krokach i wadze na interaktywnych wykresach.\n\nMożesz też dodać nowe dane o krokach lub wadze do Apple Health bezpośrednio z tej aplikacji. Twoje dane są prywatne i bezpieczne."
          }
        }
      }
    },
    "To use Step Counter with Apple Health, please enable read and write access for step count and weight data in Settings > Health > Data Access & Devices > Step Counter." : {
      "comment" : "An alert message explaining that the user needs to enable read and write access to their Apple Health data in order to use Step Counter.",
